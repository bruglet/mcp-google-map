# Copy to ~/.config/mcp-google-map/mcp-google-map.env and chmod 600.
# This file is intentionally not included in the container image or repository.

GOOGLE_MAPS_API_KEY=replace-with-server-side-google-maps-key
# Optional separate key restricted to Maps Grounding Lite.
# GOOGLE_MAPS_GROUNDING_API_KEY=replace-with-server-side-grounding-key

CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=replace-with-cloudflare-application-audience

# Set true only after reviewing Google Maps Grounding Lite’s data-use terms.
# GOOGLE_MAPS_GROUNDING_TERMS_ACK=true
